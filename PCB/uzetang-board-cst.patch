From 07bed68f688afd2ef5be04fc0c52a09480fd79d8 Mon Sep 17 00:00:00 2001
From: UzeTang <uzetang@localhost>
Date: Sun, 22 Nov 2026 12:34:51 +0000
Subject: [PATCH] Add UzeTang Board pin constraints (uzetang_board.cst)

The UzeTang Board (Tang Nano 20K carrier for the Uzebox case) wires its
RESET/USER buttons to pins 71/72 (active high) and its full-size SD socket
to 73/74/75/76/77/86. Build for it with:
  CST=uzetang_board.cst syn/oss_build.sh
  UZETANG_CST=uzetang_board.cst gw_sh build.tcl

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0141uAypy8LXT5vZHbKWaGij
---
 build.tcl                     |  5 ++-
 rtl/tang20k/uzetang_board.cst | 70 +++++++++++++++++++++++++++++++++++
 syn/oss_build.sh              |  4 +-
 3 files changed, 77 insertions(+), 2 deletions(-)
 create mode 100644 rtl/tang20k/uzetang_board.cst

diff --git a/build.tcl b/build.tcl
index 4605a91..d4f760c 100644
--- a/build.tcl
+++ b/build.tcl
@@ -28,7 +28,10 @@ add_file -type verilog "rtl/hdmi/audio_sample_packet.sv"
 add_file -type verilog "rtl/hdmi/auxiliary_video_information_info_frame.sv"
 add_file -type verilog "rtl/hdmi/source_product_description_info_frame.sv"
 add_file -type verilog "rtl/hdmi/serializer.sv"
-add_file -type cst "rtl/tang20k/uzetang.cst"
+# UZETANG_CST=uzetang_board.cst builds for the UzeTang Board
+set cst uzetang.cst
+if {[info exists ::env(UZETANG_CST)]} { set cst $::env(UZETANG_CST) }
+add_file -type cst "rtl/tang20k/$cst"
 add_file -type sdc "rtl/tang20k/uzetang.sdc"
 
 set_option -synthesis_tool gowinsynthesis
diff --git a/rtl/tang20k/uzetang_board.cst b/rtl/tang20k/uzetang_board.cst
new file mode 100644
index 0000000..ae492de
--- /dev/null
+++ b/rtl/tang20k/uzetang_board.cst
@@ -0,0 +1,70 @@
+// UzeTang - Uzebox for the Sipeed Tang Nano 20K, on the UzeTang Board
+// (Tang Nano 20K carrier PCB for the Uzebox 3D-printed case).
+// Same as uzetang.cst, except:
+//   - RESET / USER are the board's buttons on pins 71 / 72 (active high,
+//     10k pull-downs on the board), instead of the Tang's S1 / S2;
+//   - the SD card is the board's full-size socket (73/74/75/76/77/86)
+//     instead of the Tang's micro SD slot.
+// SNES pads: same pins as uzetang.cst and SNESTang.
+
+IO_LOC "sys_clk" 4;
+IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
+
+// Board buttons RESET / USER (high when pressed)
+IO_LOC "s1" 71;
+IO_PORT "s1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
+IO_LOC "s2" 72;
+IO_PORT "s2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
+
+// UART (BL616 USB serial)
+IO_LOC "uart_txd" 69;
+IO_PORT "uart_txd" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
+
+// HDMI
+IO_LOC "tmds_d_p[0]" 35,36;
+IO_PORT "tmds_d_p[0]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
+IO_LOC "tmds_d_p[1]" 37,38;
+IO_PORT "tmds_d_p[1]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
+IO_LOC "tmds_d_p[2]" 39,40;
+IO_PORT "tmds_d_p[2]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
+IO_LOC "tmds_clk_p" 33,34;
+IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
+
+// LEDs (pins 17-20 are left free for SNESTang's DS2 adapter)
+IO_LOC "led[0]" 15;
+IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
+IO_LOC "led[1]" 16;
+IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
+
+// Board SD card socket, SPI mode (10k pull-ups on DAT0-DAT3 on the board)
+IO_LOC "sd_clk" 73;
+IO_PORT "sd_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
+IO_LOC "sd_cmd" 74;
+IO_PORT "sd_cmd" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
+IO_LOC "sd_dat0" 75;
+IO_PORT "sd_dat0" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
+IO_LOC "sd_dat1" 77;
+IO_PORT "sd_dat1" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
+IO_LOC "sd_dat2" 86;
+IO_PORT "sd_dat2" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
+IO_LOC "sd_dat3" 76;
+IO_PORT "sd_dat3" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
+
+// SNES controller 1 (as SNESTang)
+IO_LOC "joy1_strb" 28;
+IO_PORT "joy1_strb" PULL_MODE=NONE IO_TYPE=LVCMOS33;
+IO_LOC "joy1_clk" 27;
+IO_PORT "joy1_clk" PULL_MODE=NONE IO_TYPE=LVCMOS33;
+IO_LOC "joy1_data" 25;
+IO_PORT "joy1_data" PULL_MODE=UP IO_TYPE=LVCMOS33;
+
+// SNES controller 2 (as SNESTang)
+IO_LOC "joy2_strb" 29;
+IO_PORT "joy2_strb" PULL_MODE=NONE IO_TYPE=LVCMOS33;
+IO_LOC "joy2_clk" 26;
+IO_PORT "joy2_clk" PULL_MODE=NONE IO_TYPE=LVCMOS33;
+IO_LOC "joy2_data" 30;
+IO_PORT "joy2_data" PULL_MODE=UP IO_TYPE=LVCMOS33;
+
+// Embedded SDRAM: no constraints needed, the O_sdram_* / IO_sdram_* port
+// names connect to the in-package SDRAM automatically.
diff --git a/syn/oss_build.sh b/syn/oss_build.sh
index 5c6d378..003c2ad 100755
--- a/syn/oss_build.sh
+++ b/syn/oss_build.sh
@@ -5,6 +5,8 @@
 # and 48 kHz audio). The HDMI pins use true LVDS buffers (TLVDS_OBUF), as
 # apicula does not allow emulated LVDS on them.
 set -e
+# CST=uzetang_board.cst syn/oss_build.sh builds for the UzeTang Board
+# (board buttons and SD socket); the default is the bare Tang Nano 20K.
 HERE=$(cd "$(dirname "$0")" && pwd)
 R=$HERE/../rtl
 OUT=$HERE/out
@@ -18,7 +20,7 @@ yosys -q -l "$OUT/yosys.log" -p "
   synth_gowin -top uzetang_top -json $OUT/uzetang.json"
 # nextpnr wants both pins of a differential pair constrained separately
 sed -E 's/IO_LOC "([a-z_]+)_p(\[[0-9]\])?" ([0-9]+),([0-9]+);/IO_LOC "\1_p\2" \3;\nIO_LOC "\1_n\2" \4;/' \
-    "$R/tang20k/uzetang.cst" > "$OUT/uzetang_oss.cst"
+    "$R/tang20k/${CST:-uzetang.cst}" > "$OUT/uzetang_oss.cst"
 $NEXTPNR --json "$OUT/uzetang.json" --write "$OUT/uzetang_pnr.json" \
     --device GW2AR-LV18QN88C8/I7 --vopt family=GW2A-18C \
     --vopt cst="$OUT/uzetang_oss.cst" --freq 28.7 --threads 2 \
-- 
