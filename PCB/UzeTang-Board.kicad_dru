(version 1)
# The SNES controller sockets are soldered to pads that run to the front
# edge of the board, exactly as on the Uzebox PCB.
(rule "SNES sockets at the board edge"
  (constraint edge_clearance (min 0mm))
  (condition "A.Reference == 'J1' || A.Reference == 'J2'"))

(rule "single spoke ok (other layer also pours GND)"
  (condition "A.NetName == 'GND'")
  (constraint min_resolved_spokes 1))
